# ============================================================
# .env.example — Variables de entorno
# ============================================================

# ---- BASE DE DATOS (Supabase) ----
# Copiar la connection string del pooler de Supabase
# Formato: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.supabase.co:6543/postgres

# ---- SUMO ----
SUMO_HOME=/usr/share/sumo
SUMO_PORT=8813

# ---- FRONTEND ----
FRONTEND_URL=http://localhost:3000
VERCEL_DOMAIN=urbamindx.vercel.app

# ---- DEBUG ----
DEBUG=False
